# Local API (defaults shown)
PORT=8787

# Offline LLM — already running on this machine
OLLAMA_HOST=http://127.0.0.1:11434

# Pin a model, or leave this and the API picks the strongest local chat model present:
# gemma4:26b → qwen3-coder:30b → gemma4:latest → qwen3:8b → qwen2.5-coder:7b → llama3.2:3b
# Cloud tags (*-cloud) are never auto-selected.
OLLAMA_MODEL=llama3.1:8b

# Strict CORS allowlist (comma-separated). Default is local Vite only.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Bind. Keep 127.0.0.1 for local demo. Render sets HOST=0.0.0.0
HOST=127.0.0.1
# TRUST_PROXY=1

# Public repo used by GET /api/github (no token required)
GITHUB_REPO=freeParameterized/digital-twin-pro

# Local STT — whisper.cpp already on this machine (WORKING_CAD_GUI / OfflineLLMGui lineage)
WHISPER_BIN=D:\OfflineLLMGui\whisper.cpp\build\bin\Release\whisper-cli.exe
WHISPER_MODEL=D:\OfflineLLMGui\whisper.cpp\ggml-base.en.bin

# Local TTS — Windows SAPI male default. This is NOT Peter's cloned voice.
VOICE_SPEAKER=male-default
TTS_VOICE=Microsoft David Desktop
# Future clone (do not enable; do not claim it is him):
# VOICE_CLONE_PATH=D:\KoboldCPP_SillyTavern_RVC\RVC\<peter-model>

# Frontend (Vite). Leave empty to use the /api proxy in local dev.
# VITE_API_URL=
# GitHub Pages project site first: https://freeParameterized.github.io/resume/
# VITE_BASE=/resume/

# Visitor log — logs/visits.log, gitignored, never served over HTTP.
# Records: UTC time, event type, coarse browser/OS family, random session id.
# Never records: IP addresses, locations, or full user-agent strings.
# Read it with: npm run visits
# VISIT_LOG=0              # turn logging off entirely
# VISIT_LOG_MESSAGES=1     # ALSO record the text of each question (default: off, length only)
# VISIT_BELL=0             # stop the terminal bell + line on a new visitor's first page view
# VISIT_LOG_MAX_BYTES=1048576   # rotate at this size (64 KB floor); one old file is kept, then overwritten

# Do not enable desktop streaming, RDP, VNC, or screen share from this process.
# See server/remote.stub.js. If added later, it belongs on a separate partition
# with its own auth — not on the public resume API.
# REMOTE_VIEWING_ENABLED=false

OLLAMA_KEEP_ALIVE=30m
